pragma solidity ^0.8.29;

import {Script, console} from "forge-std/Script.sol";

/// @notice Minimal interface to the owner-only configuration surface of MayanRouter.
interface IMayanRouterConfig {
    function owner() external view returns (address);
    function tokenOutDecimals(uint16 wormholeChainId, address token) external view returns (uint8);
    function setTokenOutDecimals(uint16 wormholeChainId, address token, uint8 decimals) external;
}

/// @title ConfigureMayanTokenList
/// @notice Configures the FULL Mayan supported-token destination table (per the
///         "Mayan Supported Tokens, Nexus Identifier Format" sheet, fetched 2026-07-13)
///         on a MayanRouter deployment: 499 (wormholeChainId, token, decimals) entries
///         across 12 destination chains (ethereum, bsc, polygon, avalanche, arbitrum,
///         optimism, base, linea, unichain, hyperevm, monad, sonic).
///         The destination table is identical on every deployment, so run once per network.
///
///         One sheet row is intentionally excluded: BSC token
///         0x7485a0aaC4856Fe63ec2Ece0C1D75C6fa82d7A22 has 0 decimals, and
///         tokenOutDecimals == 0 means "disabled" on the router, so it cannot be enabled.
///
/// @dev    Idempotent: entries already at the target value are skipped. Intended for the
///         internal-mainnet routers whose owner is an EOA (0x1F035f26710d5a3C4F7052f184564C8e4707c8f1
///         on ethereum/polygon/arbitrum/optimism/base/monad, 0x5c688B2f4D9Da1569BBDec3543C7357f57Ce1Aeb
///         on bnb/avalanche/hyperevm/megaeth). See script/configure_mayan_token_list.sh.
///
/// Required env:
///   ROUTER           router address
///   PRIVATE_KEY      router owner key (unless DRY_RUN=true)
/// Optional env:
///   DRY_RUN          true = report pending entries only, do not broadcast
contract ConfigureMayanTokenList is Script {
    uint256 internal constant ENTRY_SIZE = 23; // uint16 wh | address token | uint8 decimals

    bytes internal constant TABLE_0 =
        hex"";
    bytes internal constant TABLE_1 =
        hex"";
    bytes internal constant TABLE_2 =
        hex"";
    bytes internal constant TABLE_3 =
        hex"";

    function run() external {
        address routerAddr = vm.envAddress("ROUTER");
        require(routerAddr.code.length > 0, "No router code at ROUTER on this RPC");
        IMayanRouterConfig router = IMayanRouterConfig(routerAddr);

        bool dryRun = vm.envOr("DRY_RUN", false);
        uint256 pk;
        if (!dryRun) {
            pk = vm.envUint("PRIVATE_KEY");
            require(router.owner() == vm.addr(pk), "PRIVATE_KEY is not the router owner");
            vm.startBroadcast(pk);
        }

        bytes memory table = bytes.concat(TABLE_0, TABLE_1, TABLE_2, TABLE_3);
        uint256 entries = table.length / ENTRY_SIZE;
        uint256 pending;
        for (uint256 i; i < entries; ++i) {
            (uint16 wh, address token, uint8 dec) = _entry(table, i);
            if (router.tokenOutDecimals(wh, token) == dec) continue;
            pending++;
            if (!dryRun) router.setTokenOutDecimals(wh, token, dec);
        }
        if (!dryRun) vm.stopBroadcast();

        console.log("Router:", routerAddr);
        console.log("Table entries:", entries);
        if (dryRun) {
            console.log("Pending entries (dry run, nothing broadcast):", pending);
        } else {
            console.log("Entries updated:", pending);
        }
    }

    function _entry(bytes memory table, uint256 i) internal pure returns (uint16 wh, address token, uint8 dec) {
        uint256 offset = i * ENTRY_SIZE;
        uint256 word;
        assembly {
            word := mload(add(add(table, 32), offset))
        }
        wh = uint16(word >> 240);
        token = address(uint160(word >> 80));
        dec = uint8(word >> 72);
    }
}
